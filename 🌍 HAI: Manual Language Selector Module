<div class="hologram-panel p-4 flex items-center gap-4 bg-white/5 backdrop-blur-md rounded-2xl border border-white/10 mt-4">
    <i class="fas fa-language text-cyan-400 text-sm"></i>
    <select id="lang-select" onchange="manualLangChange()" class="bg-transparent text-[9px] text-white font-black uppercase tracking-widest outline-none cursor-pointer">
        <option value="hi-IN" class="bg-black text-white">हिन्दी (India)</option>
        <option value="en-US" class="bg-black text-white">English (Global)</option>
        <option value="ar-SA" class="bg-black text-white">العربية (UAE)</option>
        <option value="ja-JP" class="bg-black text-white">日本語 (Japan)</option>
        <option value="ru-RU" class="bg-black text-white">Русский (Russia)</option>
    </select>
    <div class="w-[1px] h-4 bg-white/10 mx-2"></div>
    <span class="text-[7px] text-cyan-500 font-bold tracking-[2px]" id="lang-status">MANUAL MODE</span>
</div>

<script>
    function manualLangChange() {
        const selectedLang = document.getElementById('lang-select').value;
        const langNames = {
            'hi-IN': "नमस्ते, हिन्दी भाषा सक्रिय की गई है।",
            'en-US': "Language switched to English.",
            'ar-SA': "تم تغيير اللغة إلى العربية",
            'ja-JP': "日本語に変更されました",
            'ru-RU': "Язык изменен पर Русский"
        };

        // UI पर स्टेटस अपडेट करना
        document.getElementById('lang-status').innerText = selectedLang.split('-')[0].toUpperCase() + " ACTIVE";
        
        // HAI का वॉयस रिस्पॉन्स
        speak(langNames[selectedLang] || "Language Updated", selectedLang);
        
        console.log(`HAI: Manual Override -> ${selectedLang}`);
    }

    // मास्टर स्पीक फंक्शन को भाषा के अनुसार अपडेट करना
    function speak(text, langCode) {
        const msg = new SpeechSynthesisUtterance(text);
        msg.lang = langCode || 'hi-IN';
        msg.rate = 0.9;
        window.speechSynthesis.speak(msg);
    }
</script>
