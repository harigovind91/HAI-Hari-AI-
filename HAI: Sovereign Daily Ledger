// HAI FINANCIAL LEDGER PROTOCOL
let dailyTransactions = JSON.parse(localStorage.getItem('HAI_LEDGER')) || [];

function recordTransaction(amount, status) {
    const timestamp = new Date().toLocaleString('hi-IN');
    const entry = {
        time: timestamp,
        amt: amount,
        id: "TXN" + Math.floor(Math.random() * 1000000),
        status: status
    };
    
    dailyTransactions.push(entry);
    localStorage.setItem('HAI_LEDGER', JSON.stringify(dailyTransactions));
    console.log(`HAI LEDGER: Entry Secured - ${amount} at ${timestamp}`);
}

// मास्टर की (786#X) से रिपोर्ट देखना
function showDailyReport() {
    let auth = prompt("दैनिक रिपोर्ट देखने के लिए मास्टर की (786#X) डालें:");
    
    if (auth === "HAI-Admin@786#X" || auth === "392") {
        let total = dailyTransactions.reduce((sum, t) => sum + parseFloat(t.amt), 0);
        let reportText = `स्वामी जी, आज का कुल व्यापार ₹${total} रहा है।\nकुल लेनदेन: ${dailyTransactions.length}`;
        
        alert(`--- HAI SOVEREIGN REPORT ---\n${reportText}`);
        speak(reportText);
    } else {
        alert("अवैध एक्सेस! डेटा सुरक्षित है।");
        speak("सुरक्षा अलर्ट: अनधिकृत व्यक्ति ने खाता देखने का प्रयास किया।");
    }
}

// पेमेंट बटन में लेजर को जोड़ना (Update processPayment)
function processPayment() {
    const amt = document.getElementById('pay-amount').value;
    if(!amt) return;
    
    // लेजर में रिकॉर्ड करना
    recordTransaction(amt, "Initiated");
    
    speak(`${amt} रुपये का भुगतान रिकॉर्ड कर लिया गया है।`);
    payDirect('upi');
}
