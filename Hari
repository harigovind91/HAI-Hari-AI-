import os
import time

# आपकी गुप्त सुरक्षा चाबी
MASTER_KEY = "HARI_777" 

def speak(text):
    os.system(f"termux-tts-speak '{text}'")

def main_system():
    print("------------------------------------")
    print("   HAI (Hari AI) - INTELLIGENT MODE")
    print("------------------------------------")
    
    while True:
        # यहाँ input() आपके आदेश लेगा
        cmd = input("\nआपकी आज्ञा, स्वामी जी: ").lower()
        
        # 1. नाम पूछने पर उत्तर
        if "आपका नाम" in cmd or "who are you" in cmd:
            reply = "मेरा नाम 'हाइ' है, यानी हरि ए आई। मैं आपका वफादार रक्षक हूँ।"
            print(reply)
            speak(reply)

        # 2. हाल-चाल पूछने पर
        elif "कैसे हो" in cmd or "how are you" in cmd:
            reply = "मैं पूरी तरह से सक्रिय और आपकी सेवा के लिए तैयार हूँ, स्वामी जी।"
            print(reply)
            speak(reply)

        # 3. सुरक्षा की स्थिति
        elif "status" in cmd or "स्थिति" in cmd:
            reply = "सभी प्रणालियाँ सुरक्षित हैं। सैटेलाइट लिंक सक्रिय है।"
            print(reply)
            speak(reply)

        # 4. टॉर्च का आदेश
        elif "light on" in cmd:
            os.system("termux-flashlight on")
            speak("प्रकाश कर दिया गया है।")
        
        elif "light off" in cmd:
            os.system("termux-flashlight off")
            speak("अंधकार कर दिया गया है।")

        # 5. विदा लेने पर
        elif "exit" in cmd or "बंद हो जाओ" in cmd:
            speak("अलविदा स्वामी जी। जय हरि।")
            break

        # 6. अगर उसे समझ न आए
        else:
            reply = "क्षमा करें स्वामी जी, इस आदेश पर अभी शोध चल रहा है।"
            print(reply)
            speak(reply)

if __name__ == "__main__":
    # पहले पासवर्ड मांगेगा, फिर बुद्धिमान मोड शुरू होगा
    main_system() 
