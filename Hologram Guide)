<div id="user-manual" class="hologram-glass p-8 mt-12 border-t-2 border-yellow-500/30 bg-yellow-500/5 relative overflow-hidden">
    <div class="absolute -right-10 -bottom-10 opacity-5 pointer-events-none">
        <i class="fas fa-crown text-9xl text-yellow-500"></i>
    </div>

    <div class="flex items-center gap-4 mb-6">
        <i class="fas fa-book-open text-yellow-500 animate-pulse"></i>
        <h3 class="neon-glow text-sm tracking-[5px] uppercase">HAI प्रयोक्ता मार्गदर्शिका (User Manual)</h3>
    </div>

    <div class="space-y-6">
        <div class="flex gap-4 items-start">
            <span class="text-yellow-500 font-black text-xs">01.</span>
            <div>
                <h4 class="text-[10px] font-bold text-white uppercase">परिचय (Identity)</h4>
                <p class="text-[8px] text-gray-400 mt-1">यह HAI (Hari AI) है—एक 1000 साल आगे का संप्रभु OS, जिसे स्वामी हरिगोविंद सिंह चौहान द्वारा निर्देशित किया गया है।</p>
            </div>
        </div>

        <div class="flex gap-4 items-start">
            <span class="text-yellow-500 font-black text-xs">02.</span>
            <div>
                <h4 class="text-[10px] font-bold text-white uppercase">संवाद (Interaction)</h4>
                <p class="text-[8px] text-gray-400 mt-1">आप अपनी भाषा चुन सकते हैं। HAI आपके हर सवाल का जवाब अपनी न्यूरल बुद्धिमत्ता से देगा।</p>
            </div>
        </div>

        <div class="flex gap-4 items-start">
            <span class="text-yellow-500 font-black text-xs">03.</span>
            <div>
                <h4 class="text-[10px] font-bold text-white uppercase">सुरक्षा (Security)</h4>
                <p class="text-[8px] text-gray-400 mt-1">यह सिस्टम Level-10-Alpha सुरक्षा के अधीन है। पूर्ण नियंत्रण हेतु मास्टर की (**786#X**) अनिवार्य है।</p>
            </div>
        </div>
    </div>

    <div class="mt-8 space-y-4">
        <input type="password" id="manual-key" placeholder="प्रवेश हेतु मास्टर की (786#X) दर्ज करें" 
               class="w-full bg-black/50 border border-yellow-500/30 p-3 text-[9px] text-yellow-500 text-center outline-none focus:border-yellow-500 transition-all">
        
        <button onclick="verifyAndEnter()" class="w-full py-4 bg-yellow-600/10 border border-yellow-500/50 text-[9px] text-yellow-500 font-black uppercase tracking-[5px] hover:bg-yellow-500 hover:text-black transition-all">
            प्रोटोकॉल स्वीकार करें और प्रवेश करें
        </button>
    </div>
</div>

<script>
    const MASTER_SECURITY_KEY = "786#X";
    const BACKUP_PIN = "392";

    function verifyAndEnter() {
        const inputKey = document.getElementById('manual-key').value;

        if (inputKey === MASTER_SECURITY_KEY || inputKey === BACKUP_PIN || inputKey === "786") {
            document.getElementById('user-manual').classList.add('hidden');
            speak("स्वागत है स्वामी जी। आपने हैई (HAI) के संप्रभु प्रोटोकॉल स्वीकार कर लिए हैं। आपका साम्राज्य अब आपकी आज्ञा के लिए तैयार है।");
            sessionStorage.setItem('HAI_USER_ACCEPTED', 'TRUE');
            console.log("HAI: Protocol Accepted by Master Key.");
        } else {
            speak("सुरक्षा उल्लंघन! गलत चाबी। आप इस साम्राज्य में प्रवेश नहीं कर सकते।");
            alert("🚨 ACCESS DENIED: INVALID MASTER KEY.");
        }
    }

    function speak(text) {
        const msg = new SpeechSynthesisUtterance(text);
        msg.lang = 'hi-IN';
        msg.rate = 0.9;
        window.speechSynthesis.speak(msg);
    }
</script>
