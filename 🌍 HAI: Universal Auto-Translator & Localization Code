// --- HAI UNIVERSAL LANGUAGE SYNC ---
function autoTranslateUI() {
    const userLang = navigator.language || navigator.userLanguage;
    const greetingMap = {
        'hi': "नमस्ते स्वामी जी, HAI सक्रिय है।",
        'en': "Welcome, I am HAI. Your sovereign system is online.",
        'ar': "أهلاً بك، أنا HAI. نظامك السيادي نشط.",
        'ja': "ようこそ、私はHAIです。あなたの主権システムはオンラインです。",
        'ru': "Добро пожаловать, я HAI. Ваша суверенная система в сети."
    };

    // भाषा का पता लगाकर बोलना
    let message = greetingMap[userLang.substring(0,2)] || greetingMap['en'];
    speak(message, userLang);

    // UI को ऑटो-प्रोफेशनल बनाना
    console.log(`HAI: User Language Detected -> ${userLang}`);
}

function speak(text, lang) {
    const msg = new SpeechSynthesisUtterance(text);
    msg.lang = lang || 'hi-IN';
    msg.rate = 0.9; // शाही और गंभीर आवाज़
    window.speechSynthesis.speak(msg);
}
