<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HAI Payment Gateway | Secure Bridge</title>
    <script src="https://cdn.tailwindcss.net"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');
        body { font-family: 'Orbitron', sans-serif; background: #00040a; color: #fff; }
        .neon-glow { border: 1px solid #00f3ff; box-shadow: 0 0 15px rgba(0, 243, 255, 0.3); }
        .gateway-card { background: linear-gradient(180deg, rgba(0,243,255,0.05) 0%, rgba(0,0,0,1) 100%); border: 1px solid rgba(0,243,255,0.2); border-radius: 20px; }
        .btn-pay { background: linear-gradient(90deg, #0088ff, #00f3ff); transition: 0.3s; }
        .btn-pay:hover { letter-spacing: 2px; box-shadow: 0 0 20px #00f3ff; }
    </style>
</head>
<body class="pb-40">

    <header class="fixed top-0 w-full z-50 p-3 bg-black/80 backdrop-blur-md border-b-2 border-cyan-500 flex justify-between items-center">
        <div class="flex items-center gap-2">
            <div class="w-10 h-10 bg-cyan-500 rounded-full flex items-center justify-center font-bold text-black">HAI</div>
            <div>
                <h1 class="text-cyan-400 text-xs font-black">PAYMENT GATEWAY</h1>
                <p class="text-[6px] text-gray-400 uppercase">Avikary Cosy Science Private Limited</p>
            </div>
        </div>
        <i class="fas fa-shield-check text-cyan-400 text-xl"></i>
    </header>

    <main class="pt-24 px-6 max-w-lg mx-auto space-y-6">
        
        <div class="gateway-card p-6 text-center">
            <p class="text-[10px] text-gray-400 mb-2">PAYMENT REQUEST TO HAI GATEWAY</p>
            <div class="text-3xl font-black text-cyan-400 mb-6">₹ <span id="display-amount">0.00</span></div>
            
            <div class="grid grid-cols-2 gap-4 mb-6">
                <button onclick="payDirect('upi')" class="p-4 rounded-xl border border-gray-800 bg-black/50 hover:border-cyan-500 transition">
                    <i class="fas fa-qrcode text-2xl mb-2 text-cyan-400"></i>
                    <p class="text-[8px] font-bold">UPI / SCAN</p>
                </button>
                <button onclick="payDirect('paypal')" class="p-4 rounded-xl border border-gray-800 bg-black/50 hover:border-cyan-500 transition">
                    <i class="fab fa-paypal text-2xl mb-2 text-blue-500"></i>
                    <p class="text-[8px] font-bold">PAYPAL / GLOBAL</p>
                </button>
            </div>

            <button onclick="startVoiceGateway()" class="w-full p-3 rounded-lg border border-dashed border-cyan-500 text-[9px] text-cyan-400 mb-4 animate-pulse">
                <i class="fas fa-microphone mr-2"></i> बोलकर राशि भरें और पेमेंट करें
            </button>

            <input type="number" id="pay-amount" placeholder="ENTER AMOUNT" class="w-full bg-black border-b border-cyan-500 p-3 text-center text-xl font-bold outline-none mb-4">
            
            <button onclick="processPayment()" class="w-full btn-pay py-4 rounded-xl font-black text-sm text-black uppercase">
                Confirm & Pay Now
            </button>
        </div>

        <div class="p-4 rounded-xl border border-gray-900 bg-gray-950/50 relative">
            <h3 class="text-[9px] font-bold text-cyan-500 mb-2 uppercase tracking-widest">Merchant Details</h3>
            <div class="text-[8px] text-gray-400 leading-relaxed">
                <p>NAME: HARIGOVIND SINGH CHAUHAN</p>
                <p>VPA: harigovindsingh91-2@okhdfcbank</p>
                <p>ORG: ACIWHO WELFARE FOUNDATION</p>
            </div>
            <i class="fas fa-certificate absolute right-4 top-4 text-cyan-700 opacity-30 text-4xl"></i>
        </div>

    </main>

    <footer class="fixed bottom-0 w-full p-4 bg-black/90 border-t border-cyan-900 flex justify-between items-center z-50">
        <div class="flex items-center gap-3">
            <div class="w-14 h-14 bg-white p-1 rounded">
                <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=upi://pay?pa=harigovindsingh91-2@okhdfcbank" alt="QR">
            </div>
            <div>
                <p class="text-[8px] font-bold text-cyan-400 uppercase">HAI Global Pay Bridge</p>
                <p class="text-[6px] text-gray-500">Secured by Master Key 786</p>
            </div>
        </div>
        <div class="text-[8px] text-right font-bold text-gray-400">
            MUMBAI | VARANASI<br>AZAMGARH
        </div>
    </footer>

    <script>
        // गेटवे फंक्शन
        function payDirect(mode) {
            const amt = document.getElementById('pay-amount').value || "0";
            if(mode === 'upi') {
                window.location.href = `upi://pay?pa=harigovindsingh91-2@okhdfcbank&pn=Harigovind%20Singh&am=${amt}&cu=INR`;
            } else {
                window.open(`https://www.paypal.com/paypalme/harigovindsingh91/${amt}`, '_blank');
            }
        }

        function processPayment() {
            const amt = document.getElementById('pay-amount').value;
            if(!amt) return alert("Please enter amount");
            alert(`HAI GATEWAY: Processing ₹${amt}\nDirecting to Secure Bank Bridge...`);
            payDirect('upi');
        }

        function startVoiceGateway() {
            alert("AI Voice Active: बोलिए कितना पेमेंट करना है?");
            // यहाँ फ्यूचर में Speech Recognition API जोड़ सकते हैं
        }

        // मास्टर की एक्सेस
        function masterAccess() {
            const pin = prompt("ENTER MASTER KEY (786):");
            if (pin === "392") { alert("Welcome Director Chauhan Ji"); }
        }
    </script>
</body>
</html>
