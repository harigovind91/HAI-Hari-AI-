        // लाइव गूगल सर्च और वॉयस कमांड
        function voiceCommand() {
            let query = prompt("स्वामी जी, आप क्या खोजना चाहते हैं? (सर्च इंजन सक्रिय है)");
            
            if (query) {
                speak(`स्वामी जी, मैं आपके लिए ${query} खोज रहा हूँ।`);
                
                // ब्राउज़र में गूगल सर्च खोलने का लिंक
                const searchUrl = `https://www.google.com/search?q=${encodeURIComponent(query)}`;
                
                // 1.5 सेकंड बाद सर्च खोलना (ताकि आवाज सुनाई दे सके)
                setTimeout(() => {
                    window.open(searchUrl, '_blank');
                }, 1500);
            }
        }
