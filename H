import os

# आपका गुप्त सुरक्षा कोड
MASTER_KEY = "HARI_777" 

def speak(text):
    # यह कमांड AI को आवाज देगा
    os.system(f"termux-tts-speak '{text}'")

def main_system():
    print("\n--- HAI (Hari AI) SMART CORE ACTIVE ---")
    speak("System is online. Master Key required.")
    
    key = input("कृपया अपनी गुप्त चाबी डालें: ")
    
    if key != MASTER_KEY:
        speak("Access Denied. Identity mismatch.")
        print("गलत चाबी! सुरक्षा अलर्ट!")
        return

    speak("Welcome Swami Harigovind Singh Ji. How can I help you today?")
    
    while True:
        cmd = input("\nआपकी आज्ञा, स्वामी जी: ").lower()
        
        # यहाँ हम AI को उत्तर देना सिखा रहे हैं
        if "कैसे हो" in cmd or "how are you" in cmd:
            ans = "मैं पूरी तरह सक्रिय हूँ और आपके अगले आदेश की प्रतीक्षा कर रहा हूँ।"
            print(ans)
            speak(ans)

        elif "नाम क्या है" in cmd:
            ans = "मेरा नाम 'हाइ' है, जिसका अर्थ है हरि ए आई।"
            print(ans)
            speak(ans)

        elif "light on" in cmd:
            os.system("termux-flashlight on")
            speak("प्रकाश कर दिया गया है।")
        
        elif "light off" in cmd:
            os.system("termux-flashlight off")
            speak("अंधकार कर दिया गया है।")

        elif "exit" in cmd or "बंद हो जाओ" in cmd:
            speak("System going to sleep. Jai Hari.")
            break
        
        else:
            ans = "क्षमा करें स्वामी जी, मुझे इस आदेश का उत्तर देना अभी सीखना है।"
            print(ans)
            speak(ans)

if __name__ == "__main__":
    main_system()

