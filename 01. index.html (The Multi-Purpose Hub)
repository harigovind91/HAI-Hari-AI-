<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HAI | Hari AI Universal</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;900&display=swap');
        body { font-family: 'Orbitron', sans-serif; background: #000; color: #fff; }
        .glass { background: rgba(255, 255, 255, 0.02); backdrop-filter: blur(15px); border: 1px solid rgba(0, 255, 204, 0.1); }
    </style>
</head>
<body class="pb-24">
    <nav class="fixed top-0 w-full z-50 p-4 glass flex justify-between items-center">
        <span class="text-cyan-400 font-black italic">HAI HARI AI</span>
        <button onclick="accessAdmin()"><i class="fas fa-fingerprint text-xl text-cyan-500"></i></button>
    </nav>

    <main id="app-view" class="pt-20 px-4 max-w-6xl mx-auto"></main>

    <nav class="fixed bottom-0 w-full glass grid grid-cols-4 p-4 z-50">
        <button onclick="show('social')" class="text-[8px] font-bold uppercase"><i class="fas fa-heart block text-lg text-pink-500"></i>Social</button>
        <button onclick="show('market')" class="text-[8px] font-bold uppercase"><i class="fas fa-shopping-cart block text-lg text-yellow-500"></i>Market</button>
        <button onclick="show('tools')" class="text-[8px] font-bold uppercase"><i class="fas fa-tools block text-lg text-blue-500"></i>Tools</button>
        <button onclick="show('jobs')" class="text-[8px] font-bold uppercase"><i class="fas fa-briefcase block text-lg text-green-500"></i>Jobs</button>
    </nav>

    <script src="master-core.js"></script>
</body>
</html>
<div id="job-tracker" style="background: rgba(0, 20, 40, 0.8); border-left: 4px solid #00f3ff; padding: 15px; margin-top: 10px; border-radius: 5px;">
    <h4 style="color: #00f3ff; font-family: 'Orbitron'; margin: 0;">GLOBAL RECRUITMENT PULSE</h4>
    <div id="live-stats" style="color: white; font-family: sans-serif; font-size: 14px; margin-top: 10px;">
        <p>📍 USA: <span style="color: #00ff88;">Processing...</span></p>
        <p>📍 INDIA: <span style="color: #00ff88;">Active Nodes...</span></p>
        <p>📍 UAE: <span style="color: #00ff88;">Matching Jobs...</span></p>
    </div>
    <div style="font-size: 10px; color: #aaa;">Data secured by HAI Master Key 🔒</div>
</div>
<main <div style="background: rgba(0,20,40,0.9); border: 2px solid #00f3ff; margin: 15px; border-radius: 15px; padding: 15px; text-align: center;">
    <h3 style="color: #00f3ff; font-family: 'Orbitron';">GLOBAL LIVE NODES</h3>
    <div id="vmap" style="width: 100%; height: 200px; background: url('https://upload.wikimedia.org/wikipedia/commons/8/80/World_map_-_low_resolution.svg') no-repeat center; background-size: contain; opacity: 0.6;"></div>
    <div style="border-top: 1px solid #00f3ff; margin-top: 10px; padding-top: 10px;">
        <p style="color: #00ff88; font-family: sans-serif;">📍 Active Recruits: <span id="job-count">Calculating...</span></p>
    </div>
</div>
