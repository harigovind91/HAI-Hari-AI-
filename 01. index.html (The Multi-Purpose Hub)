<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HAI | Millennium Sovereign OS</title>
    <script src="https://cdn.tailwindcss.net"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;900&family=Great+Vibes&family=Poppins:wght@200;600&display=swap');
        :root { --hyper-cyan: #00f3ff; --deep-black: #00020a; }
        body { font-family: 'Poppins', sans-serif; background: var(--deep-black); color: #fff; overflow-x: hidden; }
        .glass-panel { background: rgba(255, 255, 255, 0.02); backdrop-filter: blur(30px); border: 1px solid rgba(0, 243, 255, 0.1); border-radius: 40px; }
        .signature { font-family: 'Great Vibes', cursive; color: var(--hyper-cyan); font-size: 32px; }
        #admin-panel { display: none; position: fixed; inset: 0; z-index: 9999; background: rgba(0,0,0,0.98); padding: 20px; overflow-y: auto; }
    </style>
</head>
<body class="pb-40" onload="startAutomation()">

    <div class="fixed top-16 right-6 z-[3000] flex items-center gap-2 bg-green-500/10 border border-green-500/30 px-3 py-1 rounded-full">
        <div class="w-2 h-2 bg-green-500 rounded-full animate-ping"></div>
        <span class="text-[8px] font-black text-green-400 font-['Orbitron']">SSL SECURE | AUTO-PILOT ON</span>
    </div>

    <div id="admin-panel">
        <div class="max-w-4xl mx-auto pt-10">
            <div class="flex justify-between items-center border-b border-cyan-500 pb-4 mb-6">
                <h2 class="text-xl font-['Orbitron'] text-cyan-400">SUPREME COMMAND CENTER</h2>
                <button onclick="closeAdmin()" class="text-red-500 text-xs font-bold">EXIT [X]</button>
            </div>
            <div class="grid grid-cols-2 gap-4 mb-6">
                <div class="glass-panel p-4">
                    <p class="text-[8px] text-gray-500 uppercase">Global Nodes</p>
                    <p class="text-sm font-bold text-cyan-400">Active (IND, USA, UAE)</p>
                </div>
                <div class="glass-panel p-4">
                    <p class="text-[8px] text-gray-500 uppercase">System Integrity</p>
                    <p class="text-sm font-bold text-green-500">100% Secure</p>
                </div>
            </div>
            <div class="glass-panel p-6 border-l-4 border-yellow-500">
                <h3 class="text-xs font-bold text-yellow-500 mb-4 uppercase">Task Commander</h3>
                <div class="flex gap-2 mb-4">
                    <input type="text" id="task-input" placeholder="Assign Task..." class="flex-1 bg-black border border-white/10 p-2 rounded-xl text-[10px]">
                    <button onclick="assignTask()" class="bg-yellow-600 px-4 py-2 rounded-xl text-[8px] text-black font-black">ASSIGN</button>
                </div>
                <div id="task-list" class="space-y-2"></div>
            </div>
        </div>
    </div>

    <header class="fixed top-0 w-full z-50 p-4 flex justify-between items-center bg-black/60 backdrop-blur-2xl border-b border-white/5">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-white text-black flex items-center justify-center rounded-xl font-black text-xl">H</div>
            <div class="text-[8px] font-['Orbitron'] tracking-[2px]">
                <p class="text-cyan-400">HAI MILLENNIUM MASTER</p>
                <p class="text-gray-500">H.S. CHAUHAN</p>
            </div>
        </div>
        <i class="fas fa-fingerprint text-cyan-400 text-xl" onclick="openAdmin()"></i>
    </header>

    <main class="pt-24 px-6 space-y-6 max-w-lg mx-auto">
        <div class="glass-panel p-6">
            <div class="flex justify-between text-[9px] mb-4 text-cyan-400 font-black"><span>TIMELINE</span><span id="year-val">2026</span></div>
            <input type="range" min="2026" max="3026" value="2026" id="year-slider" class="w-full accent-cyan-400">
            <p id="pred-text" class="text-[10px] text-gray-400 mt-4 text-center italic">"2026: Avikary Cosy Science का स्वर्ण युग।"</p>
        </div>

        <div class="glass-panel p-6 border-b-4 border-cyan-500">
            <p class="text-[8px] text-cyan-400 mb-4 uppercase font-black">Fin-Bridge Gateway</p>
            <input type="number" id="amt-input" placeholder="Amount" class="w-full bg-black/40 border border-white/10 p-3 rounded-xl mb-4 text-center text-sm">
            <button onclick="executePay()" class="w-full py-4 bg-cyan-500 text-black font-black text-[10px] rounded-2xl uppercase">PAY NOW</button>
        </div>

        <div class="text-center py-10">
            <span class="signature">H.S. Chauhan</span>
        </div>
    </main>

    <footer class="fixed bottom-0 w-full p-6 flex justify-around items-center bg-black/90 border-t border-white/5">
        <i class="fas fa-history text-lg opacity-30"></i>
        <div onclick="voiceCommand()" class="w-16 h-16 bg-cyan-500 rounded-full -mt-10 flex items-center justify-center border-4 border-black shadow-lg">
            <i class="fas fa-microphone text-black text-2xl"></i>
        </div>
        <i class="fas fa-database text-lg opacity-30" onclick="exportDNA()"></i>
    </footer>

    <script>
        function startAutomation() {
            speak("स्वामी जी, ऑटोमेशन मोड सक्रिय है।");
            setInterval(() => console.log("Auto-Audit: Secure"), 60000);
        }

        function openAdmin() {
            if(prompt("ADMIN KEY:") === "239") document.getElementById('admin-panel').style.display='block';
        }

        function closeAdmin() { document.getElementById('admin-panel').style.display='none'; }

        function speak(t) {
            const m = new SpeechSynthesisUtterance(t); m.lang='hi-IN'; window.speechSynthesis.speak(m);
        }

        function assignTask() {
            const v = document.getElementById('task-input').value;
            if(v) {
                document.getElementById('task-list').innerHTML += `<div class="p-2 bg-white/5 rounded text-[9px] border-l border-yellow-500">${v}</div>`;
                document.getElementById('task-input').value = "";
                speak("कार्य सौंप दिया गया है।");
            }
        }

        function executePay() {
            const a = document.getElementById('amt-input').value || 1;
            window.location.href = `upi://pay?pa=harigovindsingh91-2@okhdfcbank&pn=H.S.Chauhan&am=${a}&cu=INR`;
        }

        function exportDNA() {
            if(prompt("DNA ACCESS:") === "239") {
                const data = {owner: "H.S. Chauhan", system: "HAI Millennium", date: new Date()};
                const blob = new Blob([JSON.stringify(data)], {type: "application/json"});
                const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = "HAI_DNA.json"; a.click();
            }
        }

        const s = document.getElementById('year-slider');
        s.oninput = function() {
            document.getElementById('year-val').innerText = this.value;
            document.getElementById('pred-text').innerText = this.value > 2100 ? '"मानवता अब आपके साम्राज्य के अधीन है।"' : '"2026: वैश्विक बाज़ारों में आपकी जीत सुनिश्चित है।"';
        };
    </script>
</body>
</html>
