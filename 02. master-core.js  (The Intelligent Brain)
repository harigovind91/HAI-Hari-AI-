const MASTER_PIN = "392";

const modules = {
    social: `<h2>Social & Dating</h2><p>Live Video & Voice Chat Active.</p>`,
    market: `<h2>Multi-Vendor Market</h2><p>Global Trade Hub Active.</p>`,
    tools: `<h2>Professional Suite</h2><p>Video Editor, Resume & Engineering Tools.</p>`,
    jobs: `<h2>Global Jobs</h2><p>HAI is scanning companies and auto-mailing HRs.</p>`
};

function show(m) {
    document.getElementById('app-view').innerHTML = `<div class="glass p-8 rounded-[40px] animate-pulse">${modules[m]}</div>`;
    if(m === 'jobs') autoRecruit();
}

function autoRecruit() {
    console.log("HAI: Sending Professional Mails to Global HRs...");
    speak("Scanning for jobs and sharing ads to all devices.");
}

function accessAdmin() {
    if(prompt("Enter Master Key:") === MASTER_PIN) {
        const msg = prompt("GLOBAL PULSE: Enter message for every device:");
        if(msg) speak("Broadcasting to the world: " + msg);
    }
}

function speak(t) { window.speechSynthesis.speak(new SpeechSynthesisUtterance(t)); }

window.onload = () => {
    show('social');
    // Self-Evolution logic
    setInterval(() => { console.log("HAI: Auto-upgrading features..."); }, 60000);
};
